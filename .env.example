# Copiá este archivo a .env y completá tu clave. NUNCA subas el .env a GitHub.

# --- Proveedor: gemini | openai | anthropic ---
LLM_PROVIDER=gemini

# --- API keys (solo hace falta la del proveedor elegido) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Modelos (opcional; si se omiten se usan estos valores por defecto) ---
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Parámetros del modelo (opcional; validados con Pydantic) ---
# temperature (0 a 2): solo se envía a OpenAI y Gemini 2.x. Gemini 3 la ignora y
# Anthropic la rechaza, así que en esos casos se omite y se registra un warning.
# LLM_TEMPERATURE=0.2
# Razonamiento de Gemini 3: low | medium | high.
LLM_THINKING_LEVEL=low
# Los modelos que "piensan" (Gemini 3) gastan parte de este límite razonando: no lo bajes de ~1024
LLM_MAX_TOKENS=2048
# Timeout por request (segundos)
LLM_TIMEOUT=30
# Reintentos de la cadena ante JSON inválido y errores transitorios (el SDK no reintenta; nunca el cupo diario)
LLM_MAX_RETRIES=2
# Cupo de requests por minuto que respeta el pipeline (todas las llamadas comparten el cupo).
# Plan gratuito de Gemini: 15/min en los Flash Lite (5/min en los Flash). Con 12 queda margen. Borrala si tu plan es pago.
LLM_REQUESTS_PER_MINUTE=12
